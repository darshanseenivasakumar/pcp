# Verifier server
PCP_HOST=127.0.0.1
PCP_PORT=8765
# local | docker
PCP_SANDBOX=local
PCP_TEST_TIMEOUT_S=120
PCP_CHECKER_TIMEOUT_S=30
PCP_JOURNAL_PATH=verifier/data/journal.sqlite
# Python used to run the target repo's tests (defaults to the verifier's own interpreter)
PCP_TARGET_PYTHON=

# Model gateway (OpenAI-compatible chat completions). Use provider "fake" for offline tests.
PCP_PRIMARY_PROVIDER=openai_compat
PCP_PRIMARY_BASE_URL=
PCP_PRIMARY_MODEL=
PCP_PRIMARY_API_KEY=
PCP_SECONDARY_PROVIDER=openai_compat
PCP_SECONDARY_BASE_URL=
PCP_SECONDARY_MODEL=
PCP_SECONDARY_API_KEY=
PCP_LLM_TIMEOUT_S=20
# POST /llm/simulate (Task C demo switch); set 0 to disable
PCP_ALLOW_SIMULATE=1
