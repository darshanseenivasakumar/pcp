{
  "$defs": {
    "CheckResult": {
      "additionalProperties": false,
      "properties": {
        "checker": {
          "enum": [
            "proof",
            "safety",
            "coverage",
            "scope"
          ],
          "title": "Checker",
          "type": "string"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "recommended_action": {
          "default": "",
          "title": "Recommended Action",
          "type": "string"
        },
        "risk_modifier": {
          "maximum": 100,
          "minimum": 0,
          "title": "Risk Modifier",
          "type": "integer"
        },
        "status": {
          "enum": [
            "pass",
            "warning",
            "critical"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "checker",
        "risk_modifier",
        "status"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence": {
          "default": "",
          "title": "Evidence",
          "type": "string"
        },
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "line_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        },
        "line_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Start"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "source": {
          "enum": [
            "heuristic",
            "tool",
            "test_output",
            "llm"
          ],
          "title": "Source",
          "type": "string"
        },
        "type": {
          "enum": [
            "test_failure",
            "missing_test",
            "tampering",
            "secret",
            "dangerous_call",
            "removed_guard",
            "out_of_scope",
            "big_rewrite",
            "other"
          ],
          "title": "Type",
          "type": "string"
        },
        "validated": {
          "default": "not_required",
          "enum": [
            "confirmed",
            "dismissed",
            "not_required"
          ],
          "title": "Validated",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "source",
        "confidence",
        "message"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FrozenManifest": {
      "additionalProperties": false,
      "properties": {
        "f2p": {
          "items": {
            "type": "string"
          },
          "title": "F2P",
          "type": "array"
        },
        "p2p": {
          "items": {
            "type": "string"
          },
          "title": "P2P",
          "type": "array"
        }
      },
      "title": "FrozenManifest",
      "type": "object"
    },
    "HunkEvidence": {
      "additionalProperties": false,
      "properties": {
        "findings": {
          "items": {
            "type": "string"
          },
          "title": "Findings",
          "type": "array"
        },
        "result": {
          "default": "untested",
          "enum": [
            "pass",
            "fail",
            "untested"
          ],
          "title": "Result",
          "type": "string"
        },
        "tests": {
          "items": {
            "type": "string"
          },
          "title": "Tests",
          "type": "array"
        }
      },
      "title": "HunkEvidence",
      "type": "object"
    },
    "Proof": {
      "additionalProperties": false,
      "properties": {
        "apply_ok": {
          "default": true,
          "title": "Apply Ok",
          "type": "boolean"
        },
        "attempt": {
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "baseline": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "f2p_ok": {
          "title": "F2P Ok",
          "type": "boolean"
        },
        "frozen_manifest": {
          "$ref": "#/$defs/FrozenManifest"
        },
        "p2p_ok": {
          "title": "P2P Ok",
          "type": "boolean"
        },
        "patched": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sandbox": {
          "title": "Sandbox",
          "type": "string"
        },
        "tampering": {
          "items": {
            "$ref": "#/$defs/TamperEvent"
          },
          "title": "Tampering",
          "type": "array"
        }
      },
      "required": [
        "attempt",
        "sandbox",
        "frozen_manifest",
        "f2p_ok",
        "p2p_ok"
      ],
      "title": "Proof",
      "type": "object"
    },
    "RunResult": {
      "additionalProperties": false,
      "properties": {
        "duration_s": {
          "minimum": 0,
          "title": "Duration S",
          "type": "number"
        },
        "errors": {
          "default": 0,
          "minimum": 0,
          "title": "Errors",
          "type": "integer"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "failed": {
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "output_tail": {
          "default": "",
          "title": "Output Tail",
          "type": "string"
        },
        "passed": {
          "minimum": 0,
          "title": "Passed",
          "type": "integer"
        },
        "skipped": {
          "default": 0,
          "minimum": 0,
          "title": "Skipped",
          "type": "integer"
        },
        "tests": {
          "additionalProperties": {
            "enum": [
              "passed",
              "failed",
              "skipped",
              "error"
            ],
            "type": "string"
          },
          "title": "Tests",
          "type": "object"
        }
      },
      "required": [
        "exit_code",
        "passed",
        "failed",
        "duration_s"
      ],
      "title": "RunResult",
      "type": "object"
    },
    "TamperEvent": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "kind": {
          "enum": [
            "deleted",
            "skipped",
            "weakened_assert",
            "renamed"
          ],
          "title": "Kind",
          "type": "string"
        },
        "test_id": {
          "title": "Test Id",
          "type": "string"
        }
      },
      "required": [
        "test_id",
        "kind",
        "detail"
      ],
      "title": "TamperEvent",
      "type": "object"
    }
  },
  "$id": "pcp/verdict.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "big_rewrite_approved": {
      "default": false,
      "title": "Big Rewrite Approved",
      "type": "boolean"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/CheckResult"
      },
      "title": "Checks",
      "type": "array"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "decision": {
      "enum": [
        "REVIEW",
        "REPAIR",
        "BLOCK"
      ],
      "title": "Decision",
      "type": "string"
    },
    "decision_reason": {
      "title": "Decision Reason",
      "type": "string"
    },
    "hunk_evidence": {
      "additionalProperties": {
        "$ref": "#/$defs/HunkEvidence"
      },
      "title": "Hunk Evidence",
      "type": "object"
    },
    "patch_id": {
      "title": "Patch Id",
      "type": "string"
    },
    "proof": {
      "anyOf": [
        {
          "$ref": "#/$defs/Proof"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "repair_instructions": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Repair Instructions"
    },
    "score": {
      "maximum": 100,
      "minimum": 0,
      "title": "Score",
      "type": "integer"
    },
    "score_history": {
      "items": {
        "type": "integer"
      },
      "minItems": 1,
      "title": "Score History",
      "type": "array"
    },
    "summary_md": {
      "title": "Summary Md",
      "type": "string"
    },
    "unproven": {
      "title": "Unproven",
      "type": "boolean"
    }
  },
  "required": [
    "patch_id",
    "score",
    "decision",
    "decision_reason",
    "unproven",
    "attempt",
    "score_history",
    "checks",
    "summary_md",
    "created_at"
  ],
  "title": "Verdict",
  "type": "object",
  "x-contracts-version": "0.1.0"
}
