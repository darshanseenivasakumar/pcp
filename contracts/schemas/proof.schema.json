{
  "$defs": {
    "FrozenManifest": {
      "additionalProperties": false,
      "properties": {
        "f2p": {
          "items": {
            "type": "string"
          },
          "title": "F2P",
          "type": "array"
        },
        "p2p": {
          "items": {
            "type": "string"
          },
          "title": "P2P",
          "type": "array"
        }
      },
      "title": "FrozenManifest",
      "type": "object"
    },
    "RunResult": {
      "additionalProperties": false,
      "properties": {
        "duration_s": {
          "minimum": 0,
          "title": "Duration S",
          "type": "number"
        },
        "errors": {
          "default": 0,
          "minimum": 0,
          "title": "Errors",
          "type": "integer"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "failed": {
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "output_tail": {
          "default": "",
          "title": "Output Tail",
          "type": "string"
        },
        "passed": {
          "minimum": 0,
          "title": "Passed",
          "type": "integer"
        },
        "skipped": {
          "default": 0,
          "minimum": 0,
          "title": "Skipped",
          "type": "integer"
        },
        "tests": {
          "additionalProperties": {
            "enum": [
              "passed",
              "failed",
              "skipped",
              "error"
            ],
            "type": "string"
          },
          "title": "Tests",
          "type": "object"
        }
      },
      "required": [
        "exit_code",
        "passed",
        "failed",
        "duration_s"
      ],
      "title": "RunResult",
      "type": "object"
    },
    "TamperEvent": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "kind": {
          "enum": [
            "deleted",
            "skipped",
            "weakened_assert",
            "renamed"
          ],
          "title": "Kind",
          "type": "string"
        },
        "test_id": {
          "title": "Test Id",
          "type": "string"
        }
      },
      "required": [
        "test_id",
        "kind",
        "detail"
      ],
      "title": "TamperEvent",
      "type": "object"
    }
  },
  "$id": "pcp/proof.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apply_ok": {
      "default": true,
      "title": "Apply Ok",
      "type": "boolean"
    },
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "baseline": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "f2p_ok": {
      "title": "F2P Ok",
      "type": "boolean"
    },
    "frozen_manifest": {
      "$ref": "#/$defs/FrozenManifest"
    },
    "p2p_ok": {
      "title": "P2P Ok",
      "type": "boolean"
    },
    "patched": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "sandbox": {
      "title": "Sandbox",
      "type": "string"
    },
    "tampering": {
      "items": {
        "$ref": "#/$defs/TamperEvent"
      },
      "title": "Tampering",
      "type": "array"
    }
  },
  "required": [
    "attempt",
    "sandbox",
    "frozen_manifest",
    "f2p_ok",
    "p2p_ok"
  ],
  "title": "Proof",
  "type": "object",
  "x-contracts-version": "0.1.0"
}
