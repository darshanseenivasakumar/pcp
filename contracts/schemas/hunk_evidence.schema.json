{
  "$id": "pcp/hunk_evidence.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "findings": {
      "items": {
        "type": "string"
      },
      "title": "Findings",
      "type": "array"
    },
    "result": {
      "default": "untested",
      "enum": [
        "pass",
        "fail",
        "untested"
      ],
      "title": "Result",
      "type": "string"
    },
    "tests": {
      "items": {
        "type": "string"
      },
      "title": "Tests",
      "type": "array"
    }
  },
  "title": "HunkEvidence",
  "type": "object",
  "x-contracts-version": "0.2.0"
}
